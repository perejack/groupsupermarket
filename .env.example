VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side Supabase (required for delayed auto-replies)
# NOTE: Service role key must NEVER be exposed in the browser. Set these only on Vercel.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin manual controls (optional — only needed if you want to lock down resend/queue APIs)
# If unset, /admin can view auto-emails directly and resend without pasting a token.
ADMIN_DASHBOARD_TOKEN=your_long_random_admin_token

# Cron trigger protection (recommended)
# If set, /api/process-auto-replies requires ?token=CRON_TOKEN
CRON_TOKEN=your_long_random_cron_token

# Server-side (Vercel) email forwarding for /api/forward-application
# If these are not set, the app will fall back to opening the user's email composer (mailto:).
FORWARD_TO_EMAIL=staffhiringmanager2@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_or_gmail_address
SMTP_PASS=your_smtp_password_or_gmail_app_password   # if Gmail app password, paste without spaces (or it's auto-normalized)
SMTP_FROM=your_smtp_from_address_optional
# Optional display name shown to applicants (helps inbox placement)
SMTP_FROM_NAME=Supermarket Hiring Team
# Optional reply address on auto-replies (defaults to FORWARD_TO_EMAIL or SMTP_USER)
REPLY_TO_EMAIL=staffhiringmanager2@gmail.com

# Delayed auto-reply settings (defaults: 6 hours, then 48 hours, then 72 hours)
AUTO_REPLY_DELAY_HOURS=6
AUTO_REPLY_DELAY_MINUTES=0
AUTO_REPLY_SUBJECT=Application received
AUTO_SELECTION_DELAY_HOURS=48
AUTO_SELECTION_DELAY_MINUTES=0
AUTO_ONBOARDING_DELAY_HOURS=72
AUTO_ONBOARDING_DELAY_MINUTES=0
EMPLOYEE_PORTAL_URL=https://www.recruitmentstaffportal.online/
SUPPORT_EMAIL=staffhiringmanager2@gmail.com

# HashBack (HashPay) M-Pesa Integration
HASHBACK_API_KEY=h266076iIenPhe
HASHBACK_ACCOUNT_ID=HP432450
HASHBACK_WEBHOOK_SECRET=your_hashback_webhook_secret_optional
