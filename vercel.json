{
  "crons": [
    {
      "path": "/api/process-auto-replies",
      "schedule": "*/10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_APP_URL": "https://www.supermarkethiring.space"
  }
}
